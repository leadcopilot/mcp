# ─── Reasoning (Gemini) — primary, free ──────────────────────
REASONING_PROVIDER=gemini
GEMINI_API_KEYS=key1,key2          # comma-separated; rotation tries each on 429
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
# GEMINI_API_KEY=                   # legacy single-key (superseded by GEMINI_API_KEYS)

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx        # secret — never commit a real value
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# ─── Fallback AI (optional; skipped if invalid/absent) ───────
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─── Search (optional; DuckDuckGo keyless fallback) ──────────
TAVILY_API_KEY=

# ─── BI Research Agent (Python sidecar, port 8000) ──────────
RESEARCH_API_BASE_URL=http://localhost:8000
# Deep Research LLM + embeddings use Gemini (Mistral removed — was paid).

# ─── Meta / Facebook ─────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/auth/meta/callback

# ─── Meta MCP (Tier 2, full tool catalog) — env-driven ───────
META_MCP_COMMAND=node
META_MCP_SCRIPT=

# ─── Google Ads (descoped in UI for now) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_DEVELOPER_TOKEN=

# ─── Auth (shared with the LeadPilot FastAPI backend) ────────
# MUST equal the backend's JWT_SECRET_KEY, or shared login won't verify.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_match_the_backend
JWT_ALGORITHM=HS256

# ─── Security ────────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string
# TOKEN_ENC_KEY=                    # 32-byte hex; derived from SESSION_SECRET if unset

# ─── Server ──────────────────────────────────────────────────
PORT=3001
